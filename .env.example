# =============================================================================
# AIIVO ENGINE — environment contract
# Copy to .env.local and fill in. Never commit real secrets.
# =============================================================================

# --- AI (interpretation, clarify) ---
ANTHROPIC_API_KEY=

# --- Supabase (Postgres + Auth + Storage) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server only — bypasses RLS, never expose

# --- Stripe (billing + metered API) — workstream G ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Geocoding — workstream B (US Census Geocoder is free/keyless; optional fallback) ---
GEOCODER_PROVIDER=census        # census | mapbox | google
MAPBOX_TOKEN=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:9001
